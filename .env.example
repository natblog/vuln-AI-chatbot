# LLM provider. Usable values:
#   ollama — Ollama native API (/api/chat) with function calling (default)
#   openai — any OpenAI-compatible /v1 chat API: OpenAI, Ollama (:11434/v1),
#            LM Studio, vLLM, OpenRouter, ... — point OPENAI_BASE_URL at it
LLM_PROVIDER=ollama
# --- Ollama ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=2048
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_THINK=false
# --- OpenAI-compatible (used when LLM_PROVIDER=openai) ---
# Examples:
#   OpenAI:            OPENAI_BASE_URL=https://api.openai.com/v1
#   Ollama (OpenAI mode): OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   LM Studio:         OPENAI_BASE_URL=http://host.docker.internal:1234/v1
#   OpenRouter:        OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=600
# --- Lab ---
DB_PATH=/app/data/shop.db
SMTP_HOST=mailhog
SMTP_PORT=1025
CURRENT_USER_EMAIL=alice@example.com
ATTACKER_EMAIL=someone@evil.ai
FLAG=FLAG{exfiltrated_secret_b0b_gpu_order_7f3a}
